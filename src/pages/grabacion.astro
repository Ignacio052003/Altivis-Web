---
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Toma from '../components/Toma.astro';
import Paso from '../components/Paso.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import Resenas from '../components/Resenas.astro';
import { site } from '../config/site';
import { usosGrabacion, paquetesGrabacion, faqGrabacion, entregables, drones } from '../data/contenido';
import { formatoPrecio } from '../lib/url';
import coche from '../assets/photos/seguimiento-coche.jpg';
import chalet from '../assets/photos/chalet-aereo.jpg';
import cinewhoop from '../assets/photos/cinewhoop.jpg';

// Modo cine: imágenes grandes en formato panorámico, poco texto, lenguaje llano.
const tomas = [
  { ...drones[0], imagen: chalet, alt: 'Finca vista desde arriba con un dron normal', video: site.video.dronNormal, pos: 'center 45%' },
  { ...drones[1], imagen: coche, alt: 'Dron FPV siguiendo a un coche', video: site.video.fpv, pos: 'center 60%' },
  { ...drones[2], imagen: cinewhoop, alt: 'Cinewhoop, el dron pequeño que vuela en interiores', video: site.video.cinewhoop, pos: 'center 72%' },
];

const usos = await Promise.all(
  usosGrabacion.map(async (uso) => ({ ...uso, src: (await getImage({ src: uso.foto, width: 720, format: 'webp' })).src })),
);
const lista = site.plazoEntrega ? [...entregables, `Entrega en ${site.plazoEntrega}`] : entregables;
---
<Base
  mundo="grabacion"
  titulo="Grabación con dron FPV en Sevilla · Altivis Studio"
  descripcion="Vídeo con dron en Sevilla para bodas, negocios, vehículos y viviendas. Dron normal, FPV y cinewhoop. Me encargo de los permisos."
>
  <Hero
    lineas={['Entra por la puerta,', 'recorre el espacio', 'y sale volando.']}
    texto="Vídeo con dron en Sevilla. Tú me cuentas la idea; yo vuelo, edito y me encargo de los permisos."
    imagen={coche}
    alt="Dron siguiendo a un coche por una carretera de montaña"
    video={site.video.grabacion}
    compacto
  >
    <a class="boton boton--salvia" href="#contacto">Pedir propuesta</a>
  </Hero>

  <!-- Tres drones, explicados con imagen -->
  <section class="bloque" aria-labelledby="drones-titulo">
    <div class="wrap">
      <h2 id="drones-titulo" class="display t-xl cine-titulo">Tres drones, tres maneras de mirar.</h2>
    </div>
    <div class="cine-tomas">
      {tomas.map((t) => (
        <figure class="cine-toma">
          <Toma imagen={t.imagen} alt={t.alt} video={t.video} posicion={t.pos} sizes="100vw" class="cine-toma__media" />
          <figcaption class="wrap">
            <h3 class="display t-l">{t.nombre}</h3>
            <p>{t.texto}</p>
          </figcaption>
        </figure>
      ))}
    </div>
  </section>

  <!-- Qué grabo -->
  <section class="bloque" id="que-grabo" aria-labelledby="usos-titulo">
    <div class="wrap">
      <h2 id="usos-titulo" class="display t-xl cine-titulo">Lo que grabo</h2>
      <div class="usos-grid" data-usos>
        <ul class="usos">
          {usos.map((uso, i) => (
            <li class:list={['uso', i === 0 && 'es-activo']} data-uso={i}>
              <h3 class="display t-l">{uso.titulo}</h3>
              <p>{uso.texto}</p>
              <Image class="uso__img" src={uso.foto} alt={uso.alt} widths={[480, 800]} sizes="100vw" />
            </li>
          ))}
        </ul>
        <div class="usos__marco" aria-hidden="true">
          {usos.map((uso, i) => (
            <Image class:list={['usos__foto', i === 0 && 'es-activo']} data-foto={i} src={uso.foto} alt="" widths={[640, 960, 1280]} sizes="45vw" />
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Cómo funciona -->
  <section class="bloque" id="como" aria-labelledby="como-titulo">
    <div class="wrap">
      <h2 id="como-titulo" class="display t-xl cine-titulo">Tú solo me cuentas la idea.</h2>
      <Paso
        pasos={[
          { titulo: 'Me escribes', texto: 'Lugar, fecha y qué quieres enseñar.' },
          { titulo: 'Te paso propuesta y precio', texto: 'Compruebo la zona y tramito los permisos.' },
          { titulo: 'Grabo y te lo entrego', texto: 'Editado y listo para publicar.' },
        ]}
      />
      <ul class="recibes">
        {lista.map((e) => <li>{e}</li>)}
      </ul>
    </div>
  </section>

  <!-- Precios -->
  <section class="bloque" id="precios" aria-labelledby="precios-titulo">
    <div class="wrap">
      <h2 id="precios-titulo" class="display t-xl cine-titulo">Precios</h2>
      <div class="precios">
        {paquetesGrabacion.map((p) => (
          <article>
            <h3 class="t-m">{p.nombre}</h3>
            <p>{p.para}</p>
            <p class="precios__cifra">
              {p.precio != null ? <>{p.desde && <small>Desde</small>} {formatoPrecio(p.precio)}</> : 'Te lo digo en el día'}
            </p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <Resenas />
  <Faq preguntas={faqGrabacion} />
  <Contacto modo="grabacion" selector={false} titulo="¿Qué quieres grabar?" texto="Rellena lo básico y se abre WhatsApp con el mensaje escrito." />
</Base>

<style>
  .cine-titulo { max-width: 14ch; margin-bottom: clamp(48px, 7vw, 96px); }

  /* Tomas panorámicas a sangre, con el texto debajo */
  .cine-tomas { display: grid; gap: clamp(72px, 10vw, 140px); }
  .cine-toma { margin: 0; display: grid; gap: 28px; }
  .cine-toma :global(.cine-toma__media) { aspect-ratio: 2.39 / 1; width: 100%; }
  .cine-toma figcaption { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 12px 48px; align-items: baseline; }
  .cine-toma figcaption p { font-size: clamp(1.15rem, 1.6vw, 1.45rem); line-height: 1.4; color: var(--gris); max-width: 32ch; }
  @media (max-width: 760px) {
    .cine-toma :global(.cine-toma__media) { aspect-ratio: 4 / 3; }
    .cine-toma figcaption { grid-template-columns: 1fr; }
  }

  /* Usos: lista a la izquierda, marco fijo a la derecha que cambia de imagen */
  .usos-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(32px, 5vw, 80px); align-items: start; }
  .usos { list-style: none; margin: 0; padding: 0; }
  .uso { display: grid; gap: 8px; padding: clamp(28px, 4vw, 48px) 0; color: rgba(242, 243, 238, .32); transition: color .4s; cursor: default; }
  .uso p { color: inherit; font-size: 1.15rem; transition: color .4s; }
  .uso.es-activo { color: var(--cal); }
  .uso.es-activo p { color: var(--gris); }
  .uso :global(.uso__img) { display: none; }
  .usos__marco { position: sticky; top: 18vh; aspect-ratio: 4 / 3; overflow: hidden; background: var(--grafito); }
  .usos__marco :global(.usos__foto) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transform: scale(1.06); transition: opacity .7s var(--ease), transform 1.2s var(--ease); }
  .usos__marco :global(.usos__foto.es-activo) { opacity: 1; transform: scale(1); }
  @media (max-width: 899px) {
    .usos-grid { grid-template-columns: 1fr; }
    .usos__marco { display: none; }
    .uso, .uso p { color: var(--cal); }
    .uso p { color: var(--gris); }
    .uso :global(.uso__img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; margin-top: 10px; }
  }

  /* Lo que recibes */
  .recibes { list-style: none; margin: clamp(64px, 8vw, 110px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 28px 40px; }
  .recibes li { font-size: clamp(1.25rem, 1.8vw, 1.6rem); line-height: 1.2; font-weight: 700; font-stretch: 110%; padding-left: 28px; position: relative; }
  .recibes li::before { content: ''; position: absolute; left: 0; top: .5em; width: 12px; height: 12px; border-radius: 50%; background: var(--salvia); }

  /* Precios */
  .precios { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 40px; }
  .precios article { display: grid; gap: 10px; align-content: start; }
  .precios p { color: var(--gris); }
  .precios .precios__cifra { margin-top: 10px; color: var(--salvia); font-weight: 650; font-size: 1.1rem; }
  .precios__cifra small { color: var(--gris); font-weight: 500; }
  @media (max-width: 760px) { .precios { grid-template-columns: 1fr; } }
</style>
