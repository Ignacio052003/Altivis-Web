---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import DronDiagrama from '../components/DronDiagrama.astro';
import Paso from '../components/Paso.astro';
import Faq from '../components/Faq.astro';
import Contacto from '../components/Contacto.astro';
import { site } from '../config/site';
import { serviciosTaller, faqTaller } from '../data/contenido';
import { formatoPrecio } from '../lib/url';
import soldadura from '../assets/photos/taller-soldadura.jpg';
import montaje from '../assets/photos/montaje-blanco.jpg';
import imper from '../assets/photos/impermeabilizacion.jpg';
import cinewhoop from '../assets/photos/cinewhoop.jpg';
import danos from '../assets/photos/valoracion-danos.jpg';

const galeria = [
  { src: danos, alt: 'Soporte de cámara roto y electrónica abierta para valorar daños', pie: 'Valoración de daños' },
  { src: montaje, alt: 'Dron FPV blanco recién montado', pie: 'Montaje a medida' },
  { src: imper, alt: 'Placa electrónica con recubrimiento protector', pie: 'Impermeabilización' },
  { src: cinewhoop, alt: 'Cinewhoop configurado con cámara de acción', pie: 'Cinewhoop listo para volar' },
];
---
<Base
  titulo="Taller de drones FPV · Reparación y montaje con envíos a toda España · Altivis Studio"
  descripcion="Reparación, montaje, configuración, impermeabilización y baterías para drones FPV. Diagnóstico antes de tocar nada y prueba de vuelo antes de devolverlo. Envíos a toda España desde Sevilla."
>
  <Hero
    lineas={['Tu dron,', 'otra vez', 'en el aire.']}
    texto="Reparación, montaje y puesta a punto de drones FPV. En mano en Sevilla o por mensajería desde cualquier punto de España."
    imagen={soldadura}
    alt="Soldadura de la electrónica de un dron FPV en el taller"
    video={site.video.taller}
    compacto
  >
    <a class="boton boton--salvia" href="#averia">¿Qué se ha roto?</a>
    <a class="boton boton--borde" href="#contacto">Pedir diagnóstico</a>
  </Hero>

  <div class="tema-cal" data-tema="cal">
    <!-- Diagrama -->
    <section class="bloque" id="averia" aria-labelledby="averia-titulo">
      <div class="wrap">
        <div class="cabecera">
          <h2 id="averia-titulo" class="display t-xl">¿Qué se ha roto?</h2>
          <p class="lead">Toca la pieza que crees que falla. Si no lo sabes, no pasa nada: para eso está el diagnóstico.</p>
        </div>
        <DronDiagrama />
      </div>
    </section>

    <!-- Servicios y precios -->
    <section class="bloque servicios-sec" aria-labelledby="servicios-titulo">
      <div class="wrap servicios-grid">
        <div class="cabecera cabecera--pegada">
          <h2 id="servicios-titulo" class="display t-xl">Qué arreglo</h2>
          <p class="lead">Siempre con presupuesto antes de empezar. No toco nada sin tu visto bueno.</p>
        </div>
        <ul class="servicios">
          {serviciosTaller.map((s) => (
            <li>
              <div>
                <h3 class="t-s">{s.nombre}</h3>
                <p>{s.detalle}</p>
              </div>
              <span class="servicios__precio">
                {s.precio != null ? `${s.desde ? 'desde ' : ''}${formatoPrecio(s.precio)}` : 'Tras el diagnóstico'}
              </span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- Envío -->
    <section class="bloque envio" aria-labelledby="envio-titulo">
      <div class="wrap">
        <div class="cabecera">
          <h2 id="envio-titulo" class="display t-xl">¿No estás en Sevilla? Mándamelo.</h2>
          <p class="lead">Trabajo con pilotos de toda España. Lo envías con DHL, Correos o GLS y te vuelve a casa probado.</p>
        </div>
        <Paso
          tema="cal"
          pasos={[
            { titulo: 'Me escribes', texto: 'Cuéntame qué ha pasado y mándame fotos o un vídeo del fallo.' },
            { titulo: 'Lo envías', texto: 'Bien protegido y con la empresa que prefieras. Te paso la dirección.' },
            { titulo: 'Apruebas el presupuesto', texto: 'Lo diagnostico y te digo qué tiene, cuánto cuesta y cuánto tarda.' },
            { titulo: 'Vuelve probado', texto: 'Reparado, configurado y volado antes de salir del taller.' },
          ]}
        />
      </div>
    </section>

    <!-- Galería -->
    <section class="galeria" aria-label="Trabajos del taller">
      <div class="wrap galeria__grid">
        {galeria.map((g) => (
          <figure>
            <Image src={g.src} alt={g.alt} widths={[480, 800]} sizes="(max-width: 760px) 50vw, 25vw" />
            <figcaption>{g.pie}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  </div>

  <Faq preguntas={faqTaller} tema="cal" />
  <Contacto modo="taller" selector={false} tema="cal" titulo="Cuéntame qué le pasa." texto="Rellena lo básico y se abre WhatsApp con el mensaje escrito. Las fotos y vídeos del fallo los mandas después por el chat." />
</Base>

<style>
  .cabecera { display: grid; gap: 28px; max-width: 900px; margin-bottom: clamp(56px, 8vw, 110px); }
  .tema-cal :global(.bloque + .bloque) { border-top: 1px solid rgba(17, 20, 16, .12); }

  .servicios-grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 48px clamp(40px, 6vw, 110px); align-items: start; }
  .cabecera--pegada { position: sticky; top: 120px; margin-bottom: 0; }
  .servicios { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(17, 20, 16, .16); }
  .servicios li { display: flex; justify-content: space-between; align-items: baseline; gap: 24px; padding: 24px 0; border-bottom: 1px solid rgba(17, 20, 16, .16); }
  .servicios p { color: var(--gris-osc); margin-top: 4px; max-width: 46ch; }
  .servicios__precio { font-weight: 650; white-space: nowrap; color: var(--salvia-osc); }
  @media (max-width: 900px) {
    .servicios-grid { grid-template-columns: 1fr; }
    .cabecera--pegada { position: static; }
    .servicios li { flex-direction: column; gap: 8px; }
  }

  .galeria { padding-bottom: clamp(96px, 14vw, 200px); }
  .galeria__grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .galeria figure { margin: 0; display: grid; gap: 12px; }
  .galeria :global(img) { width: 100%; height: auto; aspect-ratio: 4 / 5; object-fit: cover; }
  .galeria figcaption { font-size: .92rem; color: var(--gris-osc); }
  @media (max-width: 760px) { .galeria__grid { grid-template-columns: 1fr 1fr; } }
</style>
