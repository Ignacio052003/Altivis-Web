---
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource/share-tech-mono/index.css';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Hud from '../components/Hud.astro';
import Footer from '../components/Footer.astro';
import Intro from '../components/Intro.astro';
import { site } from '../config/site';
import { u } from '../lib/url';

interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
}
const { titulo, descripcion, imagen = '/og.jpg' } = Astro.props;
const canonica = new URL(Astro.url.pathname, Astro.site);
const imagenAbs = new URL(u(imagen), Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: site.nombre,
  description: 'Grabación aérea con drones FPV y taller de reparación de drones en Sevilla.',
  url: site.url,
  image: imagenAbs.href,
  telephone: site.telefono,
  email: site.email,
  address: { '@type': 'PostalAddress', addressLocality: 'Sevilla', addressRegion: 'Andalucía', addressCountry: 'ES' },
  areaServed: ['Sevilla', 'España'],
  sameAs: [`https://www.instagram.com/${site.instagram}/`],
};
---
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{titulo}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  <meta name="theme-color" content="#030403" />
  <link rel="icon" type="image/png" href={u('/favicon.png')} />
  <link rel="apple-touch-icon" href={u('/apple-touch-icon.png')} />
  <link rel="sitemap" href={u('/sitemap-index.xml')} />

  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_ES" />
  <meta property="og:site_name" content={site.nombre} />
  <meta property="og:title" content={titulo} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={imagenAbs} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />

  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>
    (function () {
      var d = document.documentElement;
      d.classList.add('js');
      var reducido = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var visto = false;
      try { visto = sessionStorage.getItem('altivis-armado') === '1'; } catch (e) {}
      if (!reducido) d.classList.add('animar');
      if (!reducido && !visto) d.classList.add('js-intro');
    })();
  </script>

  {site.analyticsToken && (
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: site.analyticsToken })}></script>
  )}
</head>
<body>
  <a class="skip" href="#contenido">Saltar al contenido</a>
  <Intro />
  <Nav />
  <main id="contenido">
    <slot />
  </main>
  <Footer />
  <Hud />
  <div class="grano" aria-hidden="true"></div>

  <script>
    import '../scripts/app';
  </script>
</body>
</html>
