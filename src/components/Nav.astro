---
import { site, whatsappUrl } from '../config/site';
import { u } from '../lib/url';
import Icono from './Icono.astro';

const actual = Astro.url.pathname.replace(import.meta.env.BASE_URL.replace(/\/$/, ''), '').replace(/\/$/, '') || '/';
const enlaces = [
  { href: '/grabacion', texto: 'Grabación' },
  { href: '/taller', texto: 'Taller' },
  { href: '/videografos', texto: 'Para videógrafos' },
];
---
<header class="nav" data-nav>
  <div class="nav__barra">
    <a class="nav__marca" href={u('/')} aria-label={`${site.nombre}, inicio`}>
      <img src={u('/brand/logo-blanco.png')} alt={site.nombre} width="520" height="103" />
    </a>
    <nav class="nav__enlaces" aria-label="Principal">
      {enlaces.map((e) => (
        <a href={u(e.href)} aria-current={actual === e.href ? 'page' : undefined}>{e.texto}</a>
      ))}
    </nav>
    <a class="boton boton--salvia nav__cta" href={whatsappUrl()} target="_blank" rel="noopener">
      <Icono nombre="chat" />Escríbeme
    </a>
    <button class="nav__abrir" type="button" aria-expanded="false" aria-controls="menu-movil" data-menu-abrir>
      <Icono nombre="menu" /><span class="sr-only">Abrir menú</span>
    </button>
  </div>

  <div class="menu" id="menu-movil" data-menu hidden>
    <button class="menu__cerrar" type="button" data-menu-cerrar><Icono nombre="cerrar" /><span class="sr-only">Cerrar menú</span></button>
    <nav aria-label="Menú móvil">
      <a href={u('/')} class="display">Inicio</a>
      {enlaces.map((e) => <a href={u(e.href)} class="display">{e.texto}</a>)}
    </nav>
    <div class="menu__pie">
      <a class="boton boton--salvia" href={whatsappUrl()} target="_blank" rel="noopener"><Icono nombre="chat" />{site.telefono}</a>
      <a class="enlace" href={`https://www.instagram.com/${site.instagram}/`} target="_blank" rel="noopener">@{site.instagram}</a>
    </div>
  </div>
</header>

<style>
  .nav { position: fixed; top: 0; left: 0; right: 0; z-index: 70; transition: transform .5s var(--ease); }
  .nav.es-oculta { transform: translateY(-110%); }
  .nav__barra {
    display: flex; align-items: center; gap: 32px;
    padding: 22px clamp(28px, 4.6vw, 72px);
    transition: background-color .4s, padding .4s var(--ease), color .4s;
  }
  .nav.es-solida .nav__barra { background: rgba(3, 4, 3, .72); backdrop-filter: blur(14px) saturate(1.2); padding-block: 14px; }
  .nav.es-cal .nav__barra { background: rgba(242, 243, 238, .82); color: var(--tinta); }
  .nav.es-cal .nav__marca img { filter: brightness(0); }
  .nav__marca img { width: 168px; height: auto; transition: filter .4s; }
  .nav__enlaces { display: flex; gap: 34px; margin-left: auto; font-size: .98rem; font-weight: 550; }
  .nav__enlaces a { text-decoration: none; opacity: .78; transition: opacity .2s; }
  .nav__enlaces a:hover, .nav__enlaces a[aria-current='page'] { opacity: 1; }
  .nav__enlaces a[aria-current='page'] { text-decoration: underline; text-decoration-thickness: 1.5px; text-underline-offset: 6px; }
  .nav__cta { min-height: 46px; padding: 0 22px; }
  .nav__abrir { display: none; margin-left: auto; width: 48px; height: 48px; border: 0; background: transparent; cursor: pointer; padding: 10px; }

  .menu {
    position: fixed; inset: 0; z-index: 75; background: var(--negro); color: var(--cal);
    display: flex; flex-direction: column; justify-content: space-between; padding: 96px 28px 40px;
  }
  .menu[hidden] { display: none; }
  .menu nav { display: grid; gap: 10px; }
  .menu nav a { font-size: clamp(2.4rem, 11vw, 4rem); text-decoration: none; line-height: 1.05; }
  .menu__cerrar { position: absolute; top: 18px; right: 18px; width: 52px; height: 52px; border: 0; background: transparent; padding: 12px; cursor: pointer; }
  .menu__pie { display: grid; gap: 22px; justify-items: start; }

  @media (max-width: 900px) {
    .nav__enlaces, .nav__cta { display: none; }
    .nav__abrir { display: block; }
    .nav__barra { padding: 16px 22px; }
    .nav__marca img { width: 140px; }
  }
</style>
