---
import { piezasDron, serviciosTaller } from '../data/contenido';
import { formatoPrecio } from '../lib/url';
import DronSvg from './DronSvg.astro';

// Posición de cada punto en % del lienzo (el dibujo va de -60 a 660)
const posiciones: Record<string, [number, number]> = {
  motor: [73.6, 26.4],
  camara: [50, 31.3],
  controladora: [50, 45.6],
  esc: [50, 54.9],
  frame: [65.8, 65.8],
  bateria: [50, 68.8],
  receptor: [35.8, 76.7],
};

const piezas = piezasDron.map((p) => {
  const s = serviciosTaller.find((x) => x.id === p.servicio);
  const precio = s?.precio != null ? `${s.desde ? 'Desde ' : ''}${formatoPrecio(s.precio)}` : 'Tras el diagnóstico';
  return { ...p, servicioNombre: s?.nombre ?? p.nombre, precio, pos: posiciones[p.id] };
});
---
<div class="dron" data-dron data-montaje>
  <div class="dron__lienzo">
    <DronSvg />

    {piezas.map((p) => (
      <button type="button" class="dron__punto" style={`left:${p.pos[0]}%;top:${p.pos[1]}%`} data-pieza={p.id} aria-label={p.nombre} tabindex="-1">
        <span></span>
      </button>
    ))}
  </div>

  <div class="dron__panel">
    <div class="dron__chips" role="group" aria-label="Piezas que fallan (puedes marcar varias)">
      {piezas.map((p) => (
        <button type="button" class="dron__chip-btn" data-pieza={p.id} aria-pressed="false">{p.nombre}</button>
      ))}
    </div>

    <p class="dron__vacio display t-m" data-vacio>Marca una o varias piezas.</p>

    <ul class="dron__lista" aria-live="polite">
      {piezas.map((p) => (
        <li data-ficha={p.id} data-servicio={p.servicioNombre} data-nombre={p.nombre} hidden>
          <div>
            <h3 class="t-s">{p.nombre}</h3>
            <p>{p.sintoma}</p>
          </div>
          <span>{p.precio}</span>
        </li>
      ))}
    </ul>

    <div class="dron__accion">
      <a class="boton boton--negro" href="#contacto" data-pedir>Pedir diagnóstico</a>
      <button type="button" class="dron__limpiar" data-limpiar hidden>Desmarcar todo</button>
    </div>
  </div>
</div>

<style>
  .dron { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .dron__lienzo { position: relative; aspect-ratio: 1; max-width: 720px; width: 100%; justify-self: center; }
  .dron__punto {
    position: absolute; width: 44px; height: 44px; margin: -22px 0 0 -22px; border: 0; padding: 0; background: transparent; cursor: pointer;
  }
  .dron__punto span {
    position: absolute; inset: 13px; border-radius: 50%; background: var(--cal); box-shadow: 0 0 0 2px var(--tinta);
    transition: transform .3s var(--ease), background-color .3s;
  }
  .dron__punto span::after { content: ''; position: absolute; inset: -8px; border-radius: 50%; border: 1.5px solid var(--salvia-osc); opacity: 0; animation: latido 2.4s var(--ease) infinite; }
  .dron__punto:hover span, .dron__punto.es-activa span { transform: scale(1.25); background: var(--salvia); }
  @keyframes latido { 0% { transform: scale(.6); opacity: .9; } 100% { transform: scale(1.6); opacity: 0; } }

  .dron__panel { display: grid; gap: 40px; align-content: center; }
  .dron__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .dron__chip-btn {
    min-height: 44px; padding: 0 18px; border-radius: 999px; border: 0; cursor: pointer;
    background: transparent; box-shadow: inset 0 0 0 1.5px rgba(17, 20, 16, .2); color: var(--tinta); font-weight: 600; font-size: .95rem;
    transition: background-color .25s, color .25s, box-shadow .25s;
  }
  .dron__chip-btn:hover { box-shadow: inset 0 0 0 1.5px var(--tinta); }
  .dron__chip-btn[aria-pressed='true'] { background: var(--tinta); color: var(--cal); box-shadow: none; }
  .dron__vacio { color: var(--gris-osc); max-width: 16ch; }
  .dron__vacio[hidden] { display: none; }
  .dron__lista { list-style: none; margin: 0; padding: 0; display: grid; }
  .dron__lista li { display: flex; justify-content: space-between; align-items: baseline; gap: 20px; padding: 16px 0; border-bottom: 1px solid rgba(17, 20, 16, .14); }
  .dron__lista li:first-child:not([hidden]), .dron__lista li:not([hidden]) ~ li { border-top: 0; }
  .dron__lista li[hidden] { display: none; }
  .dron__lista p { color: var(--gris-osc); margin-top: 2px; }
  .dron__lista span { font-weight: 650; font-size: .95rem; color: var(--salvia-osc); text-align: right; max-width: 14ch; }
  .dron__accion { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .dron__limpiar { border: 0; background: none; padding: 10px 0; cursor: pointer; color: var(--gris-osc); text-decoration: underline; text-underline-offset: 4px; }
  .dron__limpiar[hidden] { display: none; }

  @media (max-width: 900px) {
    .dron { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .dron__aspas { animation: none; } }
</style>
