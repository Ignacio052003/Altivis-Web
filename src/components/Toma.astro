---
// Una toma: vídeo si existe, si no la foto. Para los bloques visuales de grabación.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { u } from '../lib/url';

interface Props {
  imagen: ImageMetadata;
  alt: string;
  video?: string | null;
  sizes?: string;
  posicion?: string;
  class?: string;
}
const { imagen, alt, video, sizes = '100vw', posicion = 'center', class: clase } = Astro.props;
---
<div class:list={['toma', clase]}>
  {video ? (
    <video src={u(video)} autoplay muted loop playsinline preload="metadata" aria-label={alt} style={`object-position:${posicion}`}></video>
  ) : (
    <Image src={imagen} alt={alt} widths={[640, 960, 1400, 2000]} sizes={sizes} style={`object-position:${posicion}`} />
  )}
</div>

<style>
  .toma { position: relative; overflow: hidden; background: var(--grafito); }
  .toma :global(img), .toma video { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
