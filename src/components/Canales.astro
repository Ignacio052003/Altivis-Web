---
// Visor de grabación: un mismo marco y tres "canales" (dron normal, FPV, cinewhoop).
// Al cambiar de canal hay un golpe de estática, como en unas gafas FPV.
import type { ImageMetadata } from 'astro';
import Toma from './Toma.astro';

interface Canal { nombre: string; texto: string; imagen: ImageMetadata; alt: string; video?: string | null; pos?: string }
interface Props { canales: Canal[] }
const { canales } = Astro.props;
---
<div class="canales" data-canales>
  <div class="canales__marco">
    {canales.map((c, i) => (
      <div class:list={['canales__toma', i === 0 && 'es-activa']} data-canal-toma={i} role="tabpanel" id={`canal-${i}`} aria-labelledby={`canal-tab-${i}`}>
        <Toma imagen={c.imagen} alt={c.alt} video={c.video} posicion={c.pos} sizes="100vw" class="canales__media" />
      </div>
    ))}
    <canvas class="canales__estatica" aria-hidden="true"></canvas>
    <span class="canales__esq" aria-hidden="true"></span>
    <p class="canales__osd osd" aria-hidden="true">CANAL <span data-canales-n>1</span>/{canales.length}</p>
  </div>

  <div class="wrap canales__tabs" role="tablist" aria-label="Tipo de dron">
    {canales.map((c, i) => (
      <button type="button" role="tab" id={`canal-tab-${i}`} aria-controls={`canal-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-canal-tab={i}>
        <span class="display t-l">{c.nombre}</span>
        <span class="canales__texto">{c.texto}</span>
      </button>
    ))}
  </div>
</div>

<style>
  .canales { display: grid; gap: 0; }
  .canales__marco { position: relative; aspect-ratio: 2.2 / 1; max-height: 78svh; width: 100%; overflow: hidden; background: var(--grafito); }
  .canales__toma { position: absolute; inset: 0; visibility: hidden; }
  .canales__toma.es-activa { visibility: visible; }
  .canales__toma :global(.canales__media) { width: 100%; height: 100%; }
  .canales__estatica { position: absolute; inset: 0; width: 100%; height: 100%; image-rendering: pixelated; opacity: 0; pointer-events: none; }
  .canales__estatica.es-visible { opacity: .92; }
  .canales__osd { position: absolute; left: calc(var(--gutter) + 6px); top: 34px; font-size: 14px; color: #fff; text-shadow: 0 1px 2px rgba(0,0,0,.7); }
  .canales__esq { position: absolute; inset: 18px var(--gutter); pointer-events: none; opacity: .85;
    background:
      linear-gradient(#fff, #fff) top left / 26px 1.5px, linear-gradient(#fff, #fff) top left / 1.5px 26px,
      linear-gradient(#fff, #fff) top right / 26px 1.5px, linear-gradient(#fff, #fff) top right / 1.5px 26px,
      linear-gradient(#fff, #fff) bottom left / 26px 1.5px, linear-gradient(#fff, #fff) bottom left / 1.5px 26px,
      linear-gradient(#fff, #fff) bottom right / 26px 1.5px, linear-gradient(#fff, #fff) bottom right / 1.5px 26px;
    background-repeat: no-repeat; }
  .canales__osd { left: calc(var(--gutter) + 44px); top: 30px; }

  .canales__tabs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .canales__tabs button {
    display: grid; gap: 12px; align-content: start; text-align: left; cursor: pointer;
    padding: 30px 28px 34px 0; border: 0; border-top: 2px solid var(--linea); background: none;
    color: rgba(242, 243, 238, .38); transition: color .35s, border-color .35s;
  }
  .canales__tabs button + button { padding-left: 28px; }
  .canales__tabs button:hover { color: rgba(242, 243, 238, .75); }
  .canales__tabs button[aria-selected='true'] { color: var(--cal); border-top-color: var(--salvia); }
  .canales__texto { font-size: 1.1rem; line-height: 1.4; max-width: 30ch; }
  .canales__tabs button[aria-selected='true'] .canales__texto { color: var(--gris); }

  @media (max-width: 760px) {
    .canales__marco { aspect-ratio: 4 / 3; }
    .canales__tabs { grid-template-columns: 1fr; }
    .canales__tabs button, .canales__tabs button + button { padding: 20px 0; }
    .canales__tabs .canales__texto { display: none; }
    .canales__tabs button[aria-selected='true'] .canales__texto { display: block; }
  }
</style>
