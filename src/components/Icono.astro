---
interface Props { nombre: 'chat' | 'flecha' | 'play' | 'instagram' | 'menu' | 'cerrar' | 'correo'; class?: string }
const { nombre, class: clase } = Astro.props;
---
<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nombre === 'chat' && <path d="M20.5 11.6a8.4 8.4 0 0 1-12.3 7.4L3.5 20.5l1.6-4.5A8.4 8.4 0 1 1 20.5 11.6z" />}
  {nombre === 'flecha' && <path d="M5 12h14M13 6l6 6-6 6" />}
  {nombre === 'play' && <path d="M8 5.5v13l11-6.5z" fill="currentColor" stroke="none" />}
  {nombre === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="3.8" /><circle cx="17.2" cy="6.8" r=".6" fill="currentColor" /></>}
  {nombre === 'menu' && <path d="M4 8h16M4 16h16" />}
  {nombre === 'cerrar' && <path d="M6 6l12 12M18 6 6 18" />}
  {nombre === 'correo' && <><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m4 7 8 6 8-6" /></>}
</svg>
